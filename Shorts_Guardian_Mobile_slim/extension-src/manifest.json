{
  "manifest_version": 3,
  "name": "Shorts Guardian",
  "version": "1.5.0",
  "key": "",
  "description": "Parental monitoring for YouTube Shorts. Keyword analysis and optional Claude Vision AI — all on-device. No data leaves your browser unless you add an API key.",
  "permissions": ["storage", "tabs", "offscreen", "tabCapture", "identity", "identity.email"],
  "host_permissions": [
    "<all_urls>",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shorts Guardian",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "app.html",
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
  "client_id": "109729677758-dpdhbbs96akqc9f2486i05qogqm0t0og.apps.googleusercontent.com",
  "scopes": ["https://www.googleapis.com/auth/gmail.send"]
}
}
